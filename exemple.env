# ============================================
# DevJobs — Template de variables d'environnement
# Copier ce fichier en .env et remplacer les placeholders
# ============================================

# -------------------------------------------------
# 1. Base de données (MySQL)
# -------------------------------------------------
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=jobaggregator
MYSQL_USER=appuser
MYSQL_PASSWORD=apppassword

# -------------------------------------------------
# 2. Application Backend (Node.js / Express)
# -------------------------------------------------
PORT=3000

# Connexion MySQL
DB_HOST=localhost
DB_USER=appuser
DB_PASSWORD=apppassword
DB_NAME=jobaggregator
DB_PORT=3306

# Sécurité JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1h

# CORS — origine autorisée pour le frontend
FRONTEND_URL=http://localhost:3001

# WeLoveDevs API (ingestion des offres)
WLD_API_KEY=ta_cle_api
WLD_API_BASE_URL=https://epi-api.welovedevs.com

# Cron d'ingestion
# INGEST_CRON_SCHEDULE=0 * * * *

# Ingestion complète au démarrage du serveur
# WLD_INGEST_ON_START=true

# Compte admin par defaut (seed en base)
ADMIN_PASSWORD=admin-default-change-me

# Mode environnement
NODE_ENV=development

# -------------------------------------------------
# 3. Application Frontend (Next.js)
# Seules les variables préfixées par NEXT_PUBLIC_ sont
# exposées au navigateur.
# -------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3000
